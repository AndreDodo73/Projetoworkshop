# Copie este arquivo para .env.local (desenvolvimento) e .env.production (build de produção).
# Os valores públicos do projeto FORGEE Academy já estão no .env.local e no .env.production.
# Não coloque a chave secreta do Supabase aqui. O site só usa a chave publishable.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# false = painel abre sem login. true = exige login da equipe.
VITE_REQUIRE_AUTH=false
